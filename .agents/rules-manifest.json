{
  "version": "1.0.0",
  "rules": [
    {
      "id": "github-workflow",
      "description": "Git branching, commit format, and PR SOP",
      "file": ".agents/rules/github-workflow.md",
      "always_on": true,
      "match_keywords": [
        "git",
        "commit",
        "branch",
        "pr",
        "merge"
      ],
      "match_paths": []
    },
    {
      "id": "centralized-messages",
      "description": "UI/Bot text message constants policy",
      "file": ".agents/rules/centralized-messages.md",
      "always_on": false,
      "match_keywords": [
        "messages",
        "bot_reply"
      ],
      "match_paths": [
        "src/constants/**"
      ]
    },
    {
      "id": "telegram-limits",
      "description": "Telegram API formatting and message limits",
      "file": ".agents/rules/telegram-limits.md",
      "always_on": false,
      "match_keywords": [
        "telegram",
        "bubble",
        "strikethrough"
      ],
      "match_paths": [
        "src/sensors/**",
        "src/tools/telegram**"
      ]
    },
    {
      "id": "database-isolation",
      "description": "Strict isolation between test D1 (prj226-brain) and live production D1 (prj226-brain-prod)",
      "file": ".agents/rules/database-isolation.md",
      "always_on": true,
      "match_keywords": [
        "d1",
        "database",
        "prod",
        "test",
        "migration"
      ],
      "match_paths": []
    }
  ]
}
